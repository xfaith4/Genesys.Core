# Output directories (runtime artifacts - never committed)
out/
out-*/
.agents/
.claude/

# Generated files
generated/

# PowerShell artifacts
*.ps1~
*.swp

# Build artifacts
*.dll
*.pdb
*.cache

# Vendored runtime dependency shipped with the Conversation Analyzer
!apps/ConversationAnalyser/lib/System.Data.SQLite.dll

# Temporary files
tmp/
temp/
*.tmp

# IDE files
.vs/
.vscode/settings.json
.idea/

# OS files
.DS_Store
Thumbs.db

# Persistent user config (region, optional clientId) - not committed to source control
genesys.env.json

# .NET build output - regenerated by `dotnet build`, never committed.
# Genesys.MockServer keeps its xUnit project inside the server project directory; leaving these
# unignored let a recursive output-copy loop reach the index. See that project's
# DefaultItemExcludes for the build-side half of the fix.
bin/
obj/

# Pester -CI writes this into the working directory; it is a run artifact, not source.
testResults.xml
